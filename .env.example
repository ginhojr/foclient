# ==============================================================================
# FOCLIENT MONOREPO — Guia de Variáveis de Ambiente (.env.example)
# ==============================================================================
# 1. Copie `backend/.env.example` para `backend/.env`
# 2. Copie `frontend/.env.example` para `frontend/.env`
# ==============================================================================

# --- BACKEND (backend/.env) ---
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"
JWT_SECRET="sua-chave-jwt-forte-aqui"
JWT_REFRESH_SECRET="sua-chave-refresh-jwt-forte-aqui"
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
WHATSAPP_DEFAULT_PROVIDER="BAILEYS"
GEMINI_API_KEY=""

# --- FRONTEND (frontend/.env) ---
VITE_API_URL=http://localhost:3333/api
VITE_SOCKET_URL=http://localhost:3333

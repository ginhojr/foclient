# ==============================================================================
# FOCLIENT BACK-END — Variáveis de Ambiente (.env.example)
# Copie este arquivo para .env e preencha com suas credenciais reais.
# ==============================================================================

# Servidor HTTP + WebSocket
PORT=3333
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Banco de Dados PostgreSQL na Nuvem (Neon)
# Pooled connection (-pooler) para queries da aplicação:
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection (sem -pooler) para Prisma Migrations:
DIRECT_URL="postgresql://USER:PASSWORD@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require&connect_timeout=15"

# Segurança JWT (Access Token + Refresh Token)
JWT_SECRET="gere-uma-chave-secreta-forte-aqui"
JWT_REFRESH_SECRET="gere-outra-chave-secreta-forte-para-refresh-aqui"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_EXPIRES_IN="7d"

# Criptografia AES-256-GCM para chaves e tokens sensíveis no banco (64 caracteres hex = 32 bytes)
ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"

# Provider de WhatsApp padrão:
# BAILEYS (Multi-Device WebSocket leve, sem precisar de Chrome/Puppeteer) | META_CLOUD_API
WHATSAPP_DEFAULT_PROVIDER="BAILEYS"
WHATSAPP_SESSIONS_DIR=".wa_sessions"

# IA Generativa Opcional (Google Gemini)
# Se vazio, o sistema utiliza automaticamente o motor contextual RAG inteligente embutido
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# API Oficial da Meta (Stub pronto para migração futura)
META_API_VERSION="v21.0"
META_WEBHOOK_VERIFY_TOKEN="seu-token-de-verificacao-webhook-meta"
